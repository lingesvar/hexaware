    "content": "SELECT \r\n    agent_id,\r\n    call_date,\r\n    team,\r\n    calls_handled,\r\n    RANK() OVER (ORDER BY calls_handled DESC) AS call_rank\r\nFROM call_performance;\r\nSELECT \r\n    agent_id,\r\n    call_date,\r\n    team,\r\n    calls_handled,\r\n    ROW_NUMBER() OVER (ORDER BY calls_handled DESC) AS row_num\r\nFROM call_performance;\r\nSELECT \r\n    agent_id,\r\n    call_date,\r\n    team,\r\n    calls_handled,\r\n    RANK() OVER (ORDER BY calls_handled DESC) AS rank_num\r\nFROM call_performance;\r\nSELECT \r\n    agent_id,\r\n    call_date,\r\n    team,\r\n    calls_handled,\r\n    DENSE_RANK() OVER (ORDER BY calls_handled DESC) AS dense_rank_num\r\nFROM call_performance;\r\nSELECT \r\n    agent_id,\r\n    call_date,\r\n    team,\r\n    calls_handled,\r\n    ROW_NUMBER() OVER (ORDER BY calls_handled DESC) AS row_num,\r\n    RANK() OVER (ORDER BY calls_handled DESC) AS rank_num,\r\n    DENSE_RANK() OVER (ORDER BY calls_handled DESC) AS dense_rank_num\r\nFROM call_performance\r\nORDER BY calls_handled DESC;\r\nSELECT \r\n    team,\r\n    agent_id,\r\n    call_date,\r\n    calls_handled,\r\n    DENSE_RANK() OVER (PARTITION BY team ORDER BY calls_handled DESC) AS team_rank\r\nFROM call_performance;\r\nSELECT \r\n    agent_id,\r\n    call_date,\r\n    customer_rating,\r\n    DENSE_RANK() OVER (ORDER BY customer_rating DESC) AS rating_rank\r\nFROM call_performance;\r\nWITH ranked_performance AS (\r\n    SELECT \r\n        team,\r\n        agent_id,\r\n        call_date,\r\n        calls_handled,\r\n        DENSE_RANK() OVER (PARTITION BY team ORDER BY calls_handled DESC) AS rnk\r\n    FROM call_performance\r\n)\r\nSELECT \r\n    team,\r\n    agent_id,\r\n    call_date,\r\n    calls_handled,\r\n    rnk\r\nFROM ranked_performance\r\nWHERE rnk <= 3\r\nORDER BY team, rnk;\r\nWITH agent_daily_ranks AS (\r\n    SELECT \r\n        agent_id,\r\n        call_date,\r\n        calls_handled,\r\n        ROW_NUMBER() OVER (PARTITION BY agent_id ORDER BY calls_handled DESC, call_date ASC) AS rnk\r\n    FROM call_performance\r\n)\r\nSELECT \r\n    agent_id,\r\n    call_date AS best_performance_date,\r\n    calls_handled AS max_calls_handled\r\nFROM agent_daily_ranks\r\nWHERE rnk = 1;\r\nWITH agent_totals AS (\r\n    SELECT \r\n        agent_id,\r\n        SUM(calls_handled) AS total_calls\r\n    FROM call_performance\r\n    GROUP BY agent_id\r\n)\r\nSELECT \r\n    agent_id,\r\n    total_calls,\r\n    DENSE_RANK() OVER (ORDER BY total_calls DESC) AS agent_rank\r\nFROM agent_totals;\r\n",
