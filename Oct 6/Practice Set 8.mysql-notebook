    "content": "CREATE DATABASE IF NOT EXISTS sql_practice_pack;\r\nUSE sql_practice_pack;\r\n\r\nCREATE TABLE IF NOT EXISTS insurance_claims (\r\n claim_id INT PRIMARY KEY,\r\n customer_name VARCHAR(100),\r\n insurance_type VARCHAR(50),\r\n claim_amount DECIMAL(12,2),\r\n branch VARCHAR(50)\r\n);\r\n\r\nINSERT IGNORE INTO insurance_claims VALUES\r\n(1, 'Ajay Kumar', 'Health', 75000, 'Hyderabad'),\r\n(2, 'Meena Shah', 'Motor', 45000, 'Mumbai'),\r\n(3, 'Rohit Jain', 'Health', 125000, 'Hyderabad'),\r\n(4, 'Sara Ali', 'Travel', 30000, 'Delhi'),\r\n(5, 'Vikas Rao', 'Motor', 85000, 'Mumbai'),\r\n(6, 'Nisha Singh', 'Health', 60000, 'Delhi'),\r\n(7, 'Imran Khan', 'Travel', 55000, 'Hyderabad'),\r\n(8, 'Pooja Patel', 'Motor', 40000, 'Delhi'),\r\n(9, 'Karan Mehta', 'Health', 150000, 'Mumbai'),\r\n(10, 'Farah Ahmed', 'Travel', 35000, 'Hyderabad');\r\nWITH type_totals AS (SELECT insurance_type, SUM(claim_amount) AS total_amount FROM insurance_claims GROUP BY insurance_type) SELECT * FROM type_totals;\r\nWITH branch_totals AS (SELECT branch, SUM(claim_amount) AS total_amount FROM insurance_claims GROUP BY branch) SELECT * FROM branch_totals;\r\nWITH type_totals AS (SELECT insurance_type, SUM(claim_amount) AS total_amount FROM insurance_claims GROUP BY insurance_type) SELECT * FROM type_totals WHERE total_amount > 200000;\r\nWITH overall_avg AS (SELECT AVG(claim_amount) AS avg_claim FROM insurance_claims) SELECT c.* FROM insurance_claims c, overall_avg a WHERE c.claim_amount > a.avg_claim;\r\nWITH type_totals AS (SELECT insurance_type, SUM(claim_amount) AS total_amount FROM insurance_claims GROUP BY insurance_type) SELECT insurance_type, total_amount, DENSE_RANK() OVER (ORDER BY total_amount DESC) AS rnk FROM type_totals;\r\nWITH type_summary AS (SELECT insurance_type AS category, SUM(claim_amount) AS total_amount FROM insurance_claims GROUP BY insurance_type), branch_summary AS (SELECT branch AS category, SUM(claim_amount) AS total_amount FROM insurance_claims GROUP BY branch) SELECT * FROM type_summary UNION ALL SELECT * FROM branch_summary;\r\nSELECT * FROM insurance_claims c1 WHERE claim_amount > (SELECT AVG(claim_amount) FROM insurance_claims c2 WHERE c2.insurance_type = c1.insurance_type);\r\nSELECT * FROM insurance_claims c1 WHERE claim_amount > (SELECT AVG(claim_amount) FROM insurance_claims c2 WHERE c2.branch = c1.branch);\r\nSELECT * FROM insurance_claims c1 WHERE claim_amount = (SELECT MAX(claim_amount) FROM insurance_claims c2 WHERE c2.insurance_type = c1.insurance_type);\r\nSELECT customer_name, claim_amount, branch FROM insurance_claims c1 WHERE claim_amount > (SELECT AVG(claim_amount) FROM insurance_claims c2 WHERE c2.branch = c1.branch);\r\n",
