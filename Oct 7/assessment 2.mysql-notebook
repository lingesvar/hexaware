    "content": "CREATE DATABASE IF NOT EXISTS airline_assessment;\nUSE airline_assessment;\nCREATE TABLE IF NOT EXISTS flights (\n flight_id INT PRIMARY KEY,\n airline VARCHAR(50),\n source_city VARCHAR(50),\n destination_city VARCHAR(50),\n ticket_price DECIMAL(10,2)\n);\nINSERT IGNORE INTO flights VALUES\n(201, 'SkyJet', 'Hyderabad', 'Delhi', 6500),\n(202, 'AirWorld', 'Mumbai', 'Bangalore', 7200),\n(203, 'SkyJet', 'Delhi', 'Mumbai', 5800),\n(204, 'FlyHigh', 'Hyderabad', 'Dubai', 18000),\n(205, 'AirWorld', 'Bangalore', 'Delhi', 6900),\n(206, 'FlyHigh', 'Mumbai', 'Singapore', 22000),\n(207, 'SkyJet', 'Hyderabad', 'Mumbai', 5200);\nCREATE TABLE IF NOT EXISTS passengers (\n passenger_id INT PRIMARY KEY,\n passenger_name VARCHAR(100),\n city VARCHAR(50),\n email VARCHAR(100)\n);\nINSERT IGNORE INTO passengers VALUES\n(1, 'Aman Verma', 'Hyderabad', ' AMAN@MAIL.COM '),\n(2, 'Sara Ali', 'Mumbai', 'sara@gmail.com'), (3, 'Rakesh Rao', 'Delhi', ''),\n(4, 'Meena Shah', 'Bangalore', 'MEENA@YAHOO.COM'),\n(5, 'Farah Khan', 'Hyderabad', NULL),\n(6, 'John Mathew', 'Pune', 'john@gmail.com'),\n(7, 'Priya Das', NULL, 'priya@mail.com');\nCREATE TABLE IF NOT EXISTS bookings (\n booking_id INT PRIMARY KEY,\n passenger_id INT,\n flight_id INT,\n booking_date DATE,\n seats INT,\n status VARCHAR(20)\n);\nINSERT IGNORE INTO bookings VALUES\n(1001, 1, 201, '2026-06-01', 1, 'Confirmed'),\n(1002, 2, 202, '2026-06-02', 2, 'Confirmed'),\n(1003, 1, 204, '2026-06-03', 1, 'Confirmed'),\n(1004, 3, 203, '2026-06-04', 1, 'Cancelled'),\n(1005, 4, 205, '2026-06-05', 3, 'Confirmed'),\n(1006, 5, 207, '2026-06-06', 2, 'Confirmed'),\n(1007, 2, 206, '2026-06-07', 1, 'Confirmed'),\n(1008, 20, 201, '2026-06-08', 1, 'Confirmed'),\n(1009, 6, NULL, '2026-06-09', 2, 'Pending');\nCREATE TABLE IF NOT EXISTS airline_staff (\n employee_id INT PRIMARY KEY,\n employee_name VARCHAR(100),\n manager_id INT,\n department VARCHAR(50),\n salary DECIMAL(10,2)\n);\nINSERT IGNORE INTO airline_staff VALUES\n(1, 'Raj Kumar', NULL, 'Management', 200000),\n(2, 'Meera Rao', 1, 'Operations', 140000), (3, 'Imran Khan', 1, 'Sales', 135000),\n(4, 'Aman Shah', 2, 'Operations', 90000),\n(5, 'Priya Singh', 2, 'Operations', 85000),\n(6, 'Rohit Das', 3, 'Sales', 75000),\n(7, 'Farah Ali', 3, 'Sales', 78000),\n(8, 'Vikas Rao', 4, 'Support', 60000);\nUSE airline_assessment;\nSELECT * FROM flights WHERE source_city = 'Hyderabad';\nSELECT * FROM flights WHERE ticket_price BETWEEN 6000 AND 20000;\nSELECT * FROM flights WHERE ticket_price > 15000;\nUPDATE flights SET ticket_price = ticket_price * 1.05 WHERE airline = 'SkyJet';\nSELECT * FROM flights ORDER BY ticket_price DESC LIMIT 3;\nSELECT airline, AVG(ticket_price) AS avg_ticket_price FROM flights GROUP BY airline;\nSELECT flight_id, SUM(seats) AS total_seats_booked FROM bookings GROUP BY flight_id;\nSELECT airline, AVG(ticket_price) AS avg_ticket_price FROM flights GROUP BY airline HAVING AVG(ticket_price) > 8000;\nSELECT f.airline, SUM(b.seats * f.ticket_price) AS total_booking_value FROM bookings b JOIN flights f ON b.flight_id = f.flight_id GROUP BY f.airline;\nSELECT p.passenger_name, f.airline, f.source_city, f.destination_city, b.status FROM bookings b JOIN passengers p ON b.passenger_id = p.passenger_id JOIN flights f ON b.flight_id = f.flight_id;\nSELECT p.passenger_name, p.city, b.booking_id, b.status FROM passengers p LEFT JOIN bookings b ON p.passenger_id = b.passenger_id;\nSELECT b.* FROM bookings b LEFT JOIN passengers p ON b.passenger_id = p.passenger_id LEFT JOIN flights f ON b.flight_id = f.flight_id WHERE p.passenger_id IS NULL OR f.flight_id IS NULL;\nSELECT p.passenger_name, SUM(b.seats * f.ticket_price) AS total_booking_value FROM passengers p JOIN bookings b ON p.passenger_id = b.passenger_id JOIN flights f ON b.flight_id = f.flight_id GROUP BY p.passenger_id, p.passenger_name;\nSELECT p.passenger_name, SUM(b.seats * f.ticket_price) AS confirmed_booking_value FROM passengers p JOIN bookings b ON p.passenger_id = b.passenger_id JOIN flights f ON b.flight_id = f.flight_id WHERE b.status = 'Confirmed' GROUP BY p.passenger_id, p.passenger_name HAVING SUM(b.seats * f.ticket_price) > 10000;\n",
